{
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true,
      "addVersionUrl": true
    }
  },
  "git": {
    "tagName": "v${version}",
    "pushArgs": ["--no-follow-tags"]
  },
  "hooks": {
    "after:release": "git push origin v${version}"
  },
  "npm": {
    "publish": false
  }
}
