{
  "name": "mochi",
  "version": "3.1.0",
  "private": true,
  "description": "🎧 a self-hosted Discord music bot that doesn't suck",
  "repository": "https://github.com/bunkerlab-net/mochi.git",
  "license": "MIT",
  "type": "module",
  "types": "dts/types",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build --target=bun --production --splitting --outdir=dist --external=@discordjs/opus --external=@snazzah/davey --external=ffmpeg-static --external=bufferutil --external=utf-8-validate src/scripts/migrate-and-start.ts",
    "cache:clear-key-value": "bun run src/scripts/cache-clear-key-value.ts",
    "db:generate": "drizzle-kit generate",
    "dev": "bun --watch src/scripts/start.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "release": "release-it",
    "start": "bun run src/scripts/migrate-and-start.ts",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@types/ws": "8.18.1"
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "2.6.1",
    "@discordjs/voice": "0.19.2",
    "@elastic/ecs-pino-format": "^1.5.0",
    "array-shuffle": "^4.1.0",
    "discord-api-types": "0.38.48",
    "discord.js": "14.26.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-capacitor": "^8.0.0",
    "get-youtube-id": "^1.0.1",
    "got": "^15.0.5",
    "hasha": "^7.0.0",
    "inversify": "^8.1.0",
    "iso8601-duration": "^2.1.3",
    "libsodium-wrappers": "^0.8.4",
    "make-dir": "^5.1.0",
    "nodesplash": "^0.1.1",
    "ora": "^9.4.0",
    "p-queue": "9.3.0",
    "p-retry": "8.0.0",
    "pagination.djs": "^4.0.18",
    "parse-duration": "2.1.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "read-pkg": "10.1.0",
    "reflect-metadata": "^0.2.2",
    "sponsorblock-api": "^0.2.4",
    "spotify-uri": "^4.1.0",
    "spotify-web-api-node": "^5.0.2",
    "xbytes": "^1.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@release-it/keep-a-changelog": "^7.1.0",
    "@types/bun": "^1.3.14",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-capacitor": "^8.0.2",
    "@types/node": "^25.9.3",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/ws": "8.18.1",
    "drizzle-kit": "^0.31.10",
    "release-it": "^20.2.0",
    "sort-package-json": "^4.0.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^24.x"
  },
  "patchedDependencies": {
    "@discordjs/opus@0.10.0": "patches/@discordjs%2Fopus@0.10.0.patch"
  }
}
