{
  "name": "mochi",
  "version": "2.11.5",
  "private": true,
  "description": "🎧 a self-hosted Discord music bot that doesn't suck ",
  "repository": "https://github.com/bunkerlab-net/mochi.git",
  "license": "MIT",
  "type": "module",
  "types": "dts/types",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build --target=bun --production --splitting --outdir=dist --external=@prisma/client --external=@discordjs/opus --external=@snazzah/davey --external=@libsql/client --external=ffmpeg-static --external=opusscript --external=node-opus --external=sodium-native --external=sodium --external=tweetnacl --external=bufferutil --external=utf-8-validate src/scripts/migrate-and-start.ts",
    "cache:clear-key-value": "bun run src/scripts/cache-clear-key-value.ts",
    "dev": "bun --watch src/scripts/start.ts",
    "postinstall": "prisma generate",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "migrations:generate": "prisma migrate dev",
    "migrations:run": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "release": "release-it",
    "start": "bun run src/scripts/migrate-and-start.ts",
    "test": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@types/ws": "8.18.1"
  },
  "dependencies": {
    "@discordjs/builders": "1.14.1",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "2.6.1",
    "@discordjs/voice": "0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@distube/ytsr": "^2.0.4",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "array-shuffle": "^4.1.0",
    "debug": "^4.4.3",
    "delay": "^7.0.0",
    "discord-api-types": "0.38.48",
    "discord.js": "14.26.4",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-capacitor": "^8.0.0",
    "get-youtube-id": "^1.0.1",
    "got": "^15.0.5",
    "hasha": "^7.0.0",
    "inversify": "^8.1.0",
    "iso8601-duration": "^2.1.3",
    "libsodium-wrappers": "^0.8.4",
    "make-dir": "^5.1.0",
    "node-emoji": "^2.2.0",
    "nodesplash": "^0.1.1",
    "ora": "^9.4.0",
    "p-event": "^7.1.0",
    "p-limit": "^7.3.0",
    "p-queue": "9.3.0",
    "p-retry": "8.0.0",
    "pagination.djs": "^4.0.18",
    "parse-duration": "2.1.6",
    "prisma": "7.8.0",
    "read-pkg": "10.1.0",
    "reflect-metadata": "^0.2.2",
    "sponsorblock-api": "^0.2.4",
    "spotify-uri": "^4.1.0",
    "spotify-web-api-node": "^5.0.2",
    "sync-fetch": "^0.6.0",
    "xbytes": "^1.9.1",
    "ytsr": "^3.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@release-it/keep-a-changelog": "^7.1.0",
    "@types/bluebird": "^3.5.42",
    "@types/debug": "^4.1.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-capacitor": "^8.0.2",
    "@types/ms": "2.1.0",
    "@types/node": "^25.9.3",
    "@types/node-emoji": "^2.1.0",
    "@types/spotify-web-api-node": "^5.0.11",
    "@types/validator": "^13.15.10",
    "@types/ws": "8.18.1",
    "release-it": "^20.2.0",
    "sort-package-json": "^4.0.0",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^24.x"
  },
  "patchedDependencies": {
    "@discordjs/opus@0.10.0": "patches/@discordjs%2Fopus@0.10.0.patch"
  }
}
